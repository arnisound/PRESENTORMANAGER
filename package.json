{
  "name": "presenthor",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "adm-zip": "^0.6.1",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "description": "PresenThor by arnisoundtools.com — régie de diffusion multi-écrans pour événements",
  "scripts": {
    "start": "node server/start.js",
    "desktop": "electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux",
    "test": "node --test test/*.test.js"
  },
  "author": {
    "name": "arnisoundtools.com",
    "url": "https://arnisoundtools.com"
  },
  "build": {
    "appId": "com.presenthor.app",
    "productName": "PresenThor",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "package.json",
      "node_modules/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PresenThor"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "icon": "build/icon.png",
    "artifactName": "PresenThor-${version}-${os}-${arch}.${ext}",
    "copyright": "© 2026 arnisoundtools.com"
  },
  "optionalDependencies": {
    "@stagetimerio/grandiose": "^0.2.1"
  },
  "homepage": "https://arnisoundtools.com"
}
